#!/usr/bin/env python3
"""pm's worker command (project-manager.toml): the real `claude`, with Ponytail at `lite` for programming tasks
(kind work, any work tree); everywhere else Ponytail stays off (.claude/settings.json). Named `claude` so pm still
picks models and reads usage."""
import json
import os
import re
import shutil
import subprocess
import sys

here = os.path.dirname(os.path.realpath(__file__))
path = os.pathsep.join(p for p in os.environ.get("PATH", "").split(os.pathsep) if os.path.realpath(p or ".") != here)
real = shutil.which("claude", path=path) or sys.exit("pm-worker: no claude on PATH")
prompt = sys.stdin.read()
head = re.search(rf"^# Task {os.environ.get('PM_TASK', '')}: .*$", prompt, re.M)
coding = bool(head and ", kind work," in head[0])
args = sys.argv[1:]
if coding and "--settings" in args:
    i = args.index("--settings") + 1
    settings = json.loads(args[i])
    settings.setdefault("env", {})["PONYTAIL_DEFAULT_MODE"] = "lite"
    args[i] = json.dumps(settings)
sys.exit(subprocess.run([real, *args], input=prompt, text=True).returncode)
