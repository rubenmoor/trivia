{
  "extends": "../../app/client/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "$app/*": [
        "../../app/client/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "../../app/client/src/**/*.ts",
    "../../app/client/src/**/*.svelte",
    "vite.config.ts",
    "../../app/client/node.d.ts"
  ],
  "exclude": [
    "../../app/client/src/**/*.test.ts",
    "../../app/client/src/engine/test/"
  ]
}
