# Achievement icon PNGs (plan 86): rendered by app/desktop/achievements/render.sh.
app/desktop/achievements/png/

# Store screenshots and capsules (plan 88): rendered by authoring/store/.
authoring/store/out/

# Local mods for development (plan 112); TRIVIA_MODS_DIR overrides.
/mods/

# Report server (plan 103): local secrets and wrangler's local state.
report-server/.dev.vars
report-server/.wrangler/
