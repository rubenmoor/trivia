{
  "name": "trivia",
  "private": true,
  "workspaces": [
    "app/client",
    "authoring/ui"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "check": "npm run check --workspaces && tsc -p report-server && npm run knip && npm run ruff",
    "test": "npm run test --workspaces --if-present && node --test 'app/desktop/*.test.mjs'",
    "knip": "knip && knip --production",
    "ruff": "git ls-files -z '*.py' | xargs -0 ruff check"
  },
  "devDependencies": {
    "knip": "^6.41.0"
  }
}
